# Copy this file to ai_test_generator/.env and fill in values
# (or set them from the web app's Settings screen).

# Gemini API Key configuration is mandatory
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI / Codex (optional, only for the "Codex" model option)
OPENAI_API_KEY=

# Ollama (optional, only for the "Ollama" model option)
OLLAMA_MODEL=
OLLAMA_HOST=

#Jira Configuration [URL and Token should be mandatory]
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Qtest Configuration [Baseurl,token,project Id, requriment id should be Mandatory]
QTEST_BASE_URL=
QTEST_TOKEN=

QTEST_PROJECT_ID=
QTEST_REQUIREMENT_ID=
QTEST_PARENT_MODULE_ID=

# Review Jira Before Running (used only by the original CLI pipeline)
ENABLE_JIRA_REQURIMENT=
STORY_ID=
