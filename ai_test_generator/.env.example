# Copy to .env and fill in values. Never commit .env.
# Model IDs are free-text — enter the exact ID from each provider's console.
# Do not treat example names below as guaranteed current model IDs.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Grok (xAI) ---
GROK_API_KEY=
GROK_MODEL=
GROK_TIMEOUT=120

# --- Groq (OpenAI-compatible, https://api.groq.com/openai/v1) ---
# Free key: https://console.groq.com/keys . GROQ_MODEL defaults to llama-3.3-70b-versatile when blank.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=120
GROQ_MAX_TOKENS=8192

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_TIMEOUT=120
CLAUDE_MAX_TOKENS=8192

# --- OpenAI (also used by Codex) ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=120

# --- Codex (OpenAI family) ---
# Uses OPENAI_API_KEY. Optional override; falls back to OPENAI_MODEL, then legacy gpt-5-mini.
CODEX_MODEL=

# --- Ollama (local) ---
OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192

# --- Jira ---
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- qTest ---
QTEST_BASE_URL=
QTEST_TOKEN=
QTEST_PROJECT_ID=
QTEST_REQUIREMENT_ID=
QTEST_PARENT_MODULE_ID=

# --- Zephyr Scale ---
# Settings only — test case upload is not implemented yet.
# Example base URL (placeholder only; leave blank unless you set your own):
#   https://api.zephyrscale.smartbear.com/v2/
ZEPHYR_BASE_URL=
ZEPHYR_API_KEY=

# --- Original CLI only ---
ENABLE_JIRA_REQURIMENT=
STORY_ID=
